{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"types": [
			"$app/types",
			"node"
		],
		"paths": {
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"],
			"#lib": ["./src/lib/index.ts"],
			"#lib/*": ["./src/lib/*"]
		}
	},
	"include": [
		"src",
		"vite.config.ts",
		"eslint.config.js",
		"playwright.config.ts",
		"drizzle.config.ts"
	]
}
