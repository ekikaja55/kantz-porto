# ==============================================================================
# KANTZ-PORTO ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Salin file ini menjadi .env (cp .env.example .env) lalu isi seluruh nilainya.
# JANGAN PERNAH melakukan commit pada file .env yang berisi credentials asli.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & ORM (Supabase PostgreSQL via Drizzle)
# ------------------------------------------------------------------------------
# Ambil dari: Supabase Dashboard -> Project Settings -> Database -> Connection String
# Catatan untuk Vercel/Serverless: Disarankan menggunakan 'Transaction' connection pooler (port 6543)
# Format: postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgres://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# ------------------------------------------------------------------------------
# 2. WEB APPLICATION & BASE URL
# ------------------------------------------------------------------------------
# URL domain aplikasi.
# Local development : http://localhost:5173
# Production        : https://your-domain.vercel.app
ORIGIN="http://localhost:5173"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION (Better Auth)
# ------------------------------------------------------------------------------
# Secret key 32+ karakter dengan entropi tinggi untuk enkripsi session cookie Better Auth.
# Cara generate di terminal: openssl rand -base64 32
BETTER_AUTH_SECRET="your-32-character-high-entropy-random-secret"

# Kredensial akun admin tunggal (digunakan untuk login pertama kali / seeding CMS)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="super-strong-admin-password"

# ------------------------------------------------------------------------------
# 4. RATE LIMITING & VISITOR ANALYTICS (Upstash Redis)
# ------------------------------------------------------------------------------
# Ambil dari: Upstash Console (https://console.upstash.com) -> Redis -> Database Anda
# Gulir ke bagian 'REST API' lalu pilih tab '.env'
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# ------------------------------------------------------------------------------
# 5. STORAGE & CLIENT API (Supabase Storage - Project Thumbnails)
# ------------------------------------------------------------------------------
# Referensi resmi: https://supabase.com/docs/guides/getting-started/api-keys
# Ambil dari: Supabase Dashboard -> Project Settings -> API Keys
#
# Supabase memiliki 2 generasi sistem key:
# 1. Format Baru (Publishable Key): diawali prefix `sb_publishable_...`
# 2. Format Legacy (Anon Key): string JWT panjang diawali `eyJ...`
#
# Kedua format tersebut aman diekspos ke publik/browser (client-side) karena dibatasi
# oleh Row Level Security (RLS) PostgreSQL & Storage bucket policy.
# Anda dapat memasukkan salah satu (Publishable Key baru ATAU Anon Key legacy) pada variable di bawah:
PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="sb_publishable_your-publishable-key-or-legacy-anon-jwt"
